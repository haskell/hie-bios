cabal-version: 3.0
name: simple-cabal
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
    A
    B

  build-depends: base >=4.10 && <5
  ghc-options:
    +RTS
    -A1m
    -N
    -RTS
    -Wall

  hs-source-dirs: src
  default-language: Haskell2010

test-suite simple-test
  type: exitcode-stdio-1.0
  main-is: test/Main.hs
  build-depends:
    base,
    simple-cabal,

  default-language: Haskell2010
